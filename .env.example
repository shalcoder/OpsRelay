# Runtime
OPSRELAY_MODE=local
AWS_REGION=ap-south-1
OPSRELAY_TABLE_NAME=OpsRelayTable
OPSRELAY_RAW_BUCKET=
OPSRELAY_EVENT_BUS=default
OPSRELAY_QUEUE_URL=
SAGEMAKER_ENDPOINT_NAME=
SAGEMAKER_ENABLED=false
STRANDS_ENABLED=false
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
CORS_ORIGINS=http://localhost:8080

# Optional Cognito / cloud UI
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# ONLY for one-time deployment scripts; prefer AWS IAM roles/SSO instead of static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# SageMaker deployment placeholder: IAM role SageMaker can assume.
SAGEMAKER_EXECUTION_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/<SAGEMAKER_EXECUTION_ROLE>
SAGEMAKER_IMAGE_URI=
SAGEMAKER_ENDPOINT_MEMORY_MB=2048
SAGEMAKER_MAX_CONCURRENCY=1
